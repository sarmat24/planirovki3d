{
  "functions": {
    "api/telegram.ts": { "maxDuration": 60 },
    "api/webapp.ts": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
